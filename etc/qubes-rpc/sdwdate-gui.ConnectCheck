#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## This script runs on the gateway. It detects if the qrexec socket that
## allows a client VM to connect to the server is present or not. It outputs
## one of the following values:
##
## * 'y' - Yes, sdwdate-gui.Connect qrexec endpoint is ready to use.
## * 'n' - No, sdwdate-gui.Connect qrexec endpoint is not ready to use but is
##         intended to become available later.
## * 'q' - No, sdwdate-gui.Connect qrexec endpoint is not ready to use and
##         will not become available later, therefore the caller should exit.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Every failure here means "the caller should give up", which is 'q' on stdout
## and exit 0 -- so the failures are handled explicitly rather than left to
## errexit, which would exit non-zero with no verdict for the caller to read.
uid="$(id -u)" || { printf '%s\n' 'q'; exit 0; }
sdwdate_gui_tmp_dir="/run/user/${uid}/sdwdate-gui"

## See if the socket for sdwdate-gui-server exists or not.
if [ -S '/run/qubes-rpc/sdwdate-gui.Connect' ]; then
  ## Endpoint is ready.
  printf '%s\n' 'y'
else
  if ! mkdir --parents -- "${sdwdate_gui_tmp_dir}"; then
    ## If we can't create this directory, something is very wrong, and the
    ## caller should give up.
    printf '%s\n' 'q'
    exit 0
  fi
  if [ -f "${sdwdate_gui_tmp_dir}/proxy-should-run" ]; then
    ## If we've already cached the fact that the server is enabled, tell the
    ## caller to keep waiting.
    printf '%s\n' 'n'
    exit 0
  fi
  ## Left as a substitution inside the test: errexit does not apply to a
  ## condition, so a failing config-read yields an empty string, misses the
  ## 'false' comparison and falls through to the 'q' verdict below -- which is
  ## the right answer. Verified, not assumed: reverting the defensive rewrite
  ## changed no test result.
  if [ "$(/usr/libexec/sdwdate-gui/sdwdate-gui-config-read 'disable')" = 'false' ]; then
    ## If the server is enabled, tell the caller to keep waiting and cache this
    ## fact so we don't have to re-parse the configuration file over and over.
    ## '|| true': the cache is an OPTIMISATION -- it saves re-parsing the
    ## config on the next poll. A read-only or full /run must not stop this
    ## script emitting its verdict, and under errexit a failing touch aborted
    ## with NO output at all, leaving the caller with nothing to act on. That
    ## contradicts this file's whole contract: always one of y, n or q on
    ## stdout.
    touch -- "${sdwdate_gui_tmp_dir}/proxy-should-run" || true
    printf '%s\n' 'n'
    exit 0
  fi
  ## Server is disabled, tell the caller to give up.
  printf '%s\n' 'q'
fi
