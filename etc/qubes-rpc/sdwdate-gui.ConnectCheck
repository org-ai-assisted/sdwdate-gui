#!/bin/bash

## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## This script runs on the gateway. It detects if the qrexec socket that
## allows a client VM to connect to the server is present or not. It outputs
## one of the following values:
##
## * 'y' - Yes, sdwdate-gui.Connect qrexec endpoint is ready to use.
## * 'q' - No, sdwdate-gui.Connect qrexec endpoint is not ready to use and
##         will not become available later, therefore the caller should exit.
##
## Note that if the server is not yet running but is expected to start running,
## this script will hang until the server starts running.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/light_sleep.bsh
source "${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/light_sleep.bsh"

exithandler() {
  local exit_code="$?"
  if [ "${exit_code}" != '0' ]; then
    printf '%s\n' 'q'
  else
    printf '%s\n' 'y'
  fi
  return "${exit_code}"
}
trap exithandler EXIT

if [ "$(/usr/libexec/sdwdate-gui/sdwdate-gui-config-read 'disable')" != 'false' ] \
  || [ "$(/usr/libexec/sdwdate-gui/sdwdate-gui-config-read 'run_server_in_qubes')" != 'true' ]; then
  exit 1
fi

while true; do
  ## See if the socket for sdwdate-gui-server exists or not. We could use
  ## inotifywait here but this is a very lightweight check and inotifywait
  ## consumes limited file watcher resources.
  if [ -S '/run/qubes-rpc/sdwdate-gui.Connect' ]; then
    ## Endpoint is ready.
    exit 0
  fi
  if [ -f /run/sdwdate-gui-qubes-proxy-helper-failed ]; then
    ## Something went really wrong while trying to set up sdwdate-gui's qrexec
    ## socket.
    exit 1
  fi
  light_sleep 1
done
